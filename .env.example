ENVIRONMENT=development
DATABASE_URL=sqlite:///./cezar-local.db
PUBLIC_BASE_URL=http://localhost:8000
PAYMENT_MODE=mock
ADMIN_TOKEN=replace-with-a-long-random-value
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-long-random-value
