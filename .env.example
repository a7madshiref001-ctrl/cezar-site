# Never expose this key in browser JavaScript or commit a real value.
GYM_API_MODE=disabled
GYM_API_BASE_URL=
GYM_API_KEY=
# Leave blank until the merchant account and final adapter are approved.
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
